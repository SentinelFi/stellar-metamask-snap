{
  "name": "stellar-metamask-snap",
  "version": "0.1.0",
  "private": true,
  "description": "Monorepo for the Stellar Soroban MetaMask Snap: SEP-0005 key derivation, SEP-43 signing API, and companion dapp.",
  "homepage": "https://github.com/SentinelFi/stellar-metamask-snap#readme",
  "bugs": {
    "url": "https://github.com/SentinelFi/stellar-metamask-snap/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SentinelFi/stellar-metamask-snap.git"
  },
  "license": "Apache-2.0",
  "author": "SentinelFi",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "yarn workspaces foreach --parallel --topological --verbose run build",
    "build:docs": "node scripts/build-docs.mjs",
    "check:versions": "node scripts/check-versions.mjs",
    "lint": "yarn lint:eslint && yarn lint:misc --check && yarn lint:characters",
    "lint:characters": "node scripts/check-control-characters.mjs",
    "lint:eslint": "eslint . --cache",
    "lint:fix": "yarn lint:eslint --fix && yarn lint:misc --write",
    "lint:misc": "prettier '**/*.json' '**/*.md' '**/*.yml' '!.yarnrc.yml' --ignore-path .gitignore --no-error-on-unmatched-pattern",
    "setup:hooks": "git config core.hooksPath .githooks",
    "start": "yarn workspaces foreach --parallel --interlaced --verbose run start",
    "test": "yarn workspace stellar-soroban-snap run test && yarn workspace stellar-soroban-snap-connector run test",
    "typecheck": "yarn workspaces foreach --parallel --verbose run typecheck"
  },
  "resolutions": {
    "@metamask/superstruct": "^3.4.1",
    "cookie": "^0.7.1",
    "engine.io": "^6.6.7",
    "lodash": "^4.18.1",
    "path-to-regexp@0.1.10": "^0.1.13",
    "path-to-regexp@0.1.12": "^0.1.13",
    "sharp": "^0.35.0",
    "socket.io": "^4.8.3",
    "socket.io-parser": "^4.2.7",
    "svgo": "^2.8.3",
    "tmp": "^0.2.6",
    "uuid": "^11.1.1",
    "webpack": "^5.104.1",
    "ws": "^8.21.0",
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "@lavamoat/allow-scripts": "^3.3.4",
    "@lavamoat/preinstall-always-fail": "^2.0.0",
    "@metamask/eslint-config": "^14.0.0",
    "@metamask/eslint-config-browser": "^14.0.0",
    "@metamask/eslint-config-jest": "^14.0.0",
    "@metamask/eslint-config-nodejs": "^14.0.0",
    "@metamask/eslint-config-typescript": "^14.0.0",
    "eslint": "^9.11.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^3.6.3",
    "eslint-plugin-import-x": "^4.3.0",
    "eslint-plugin-jest": "^28.8.3",
    "eslint-plugin-jsdoc": "^50.2.4",
    "eslint-plugin-n": "^17.10.3",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-promise": "^7.1.0",
    "marked": "^12.0.1",
    "prettier": "^3.3.3",
    "prettier-plugin-packagejson": "^2.2.18",
    "sharp": "^0.35.0",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.6.0"
  },
  "packageManager": "yarn@3.2.1",
  "engines": {
    "node": "^22.0.0"
  },
  "lavamoat": {
    "allowScripts": {
      "@lavamoat/preinstall-always-fail": false,
      "@swc/core": false,
      "core-js": false,
      "core-js-pure": false,
      "es5-ext": false,
      "gatsby": false,
      "gatsby-cli": false,
      "lmdb": false,
      "msgpackr-extract": false
    }
  }
}
