{
  "name": "site",
  "version": "0.1.0",
  "private": true,
  "description": "Companion dapp for the Stellar Soroban MetaMask Snap.",
  "license": "Apache-2.0",
  "author": "jeffnuclear",
  "scripts": {
    "allow-scripts": "yarn workspace stelllar-metamask-snap allow-scripts",
    "build": "cross-env GATSBY_TELEMETRY_DISABLED=1 gatsby build",
    "clean": "node -e \"fs.rmSync('public', { recursive: true, force: true })\"",
    "lint": "yarn lint:eslint && yarn lint:misc --check",
    "lint:eslint": "eslint . --cache",
    "lint:fix": "yarn lint:eslint --fix && yarn lint:misc --write",
    "lint:misc": "prettier '**/*.json' '**/*.md' '**/*.yml' '!.yarnrc.yml' --ignore-path ../../.gitignore --no-error-on-unmatched-pattern",
    "start": "cross-env GATSBY_TELEMETRY_DISABLED=1 gatsby develop",
    "typecheck": "tsc --noEmit"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "dependencies": {
    "@metamask/providers": "^22.1.0",
    "@stellar/stellar-sdk": "^16.2.0",
    "buffer": "^6.0.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-is": "^18.2.0",
    "stellar-soroban-snap-connector": "workspace:*",
    "styled-components": "5.3.3"
  },
  "devDependencies": {
    "@svgr/webpack": "^6.4.0",
    "@testing-library/dom": "^8.17.1",
    "@testing-library/jest-dom": "^5.16.4",
    "@testing-library/react": "^13.3.0",
    "@testing-library/user-event": "^13.5.0",
    "@types/jest": "^27.5.2",
    "@types/react": "^18.0.15",
    "@types/react-dom": "^18.0.6",
    "@types/styled-components": "^5.1.25",
    "cross-env": "^7.0.3",
    "eslint": "^9.11.0",
    "gatsby": "^5.14.5",
    "gatsby-plugin-manifest": "^5.14.0",
    "gatsby-plugin-styled-components": "^6.14.0",
    "gatsby-plugin-svgr": "^3.0.0-beta.0",
    "typescript": "~5.7.3"
  },
  "engines": {
    "node": "^22.0.0"
  }
}
