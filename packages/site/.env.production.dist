# Rename to `.env.production` and set the production values here.
#
# Both names carry the `GATSBY_` prefix because that is Gatsby's documented
# contract for variables that must reach browser code. Unprefixed names are
# visible to the build but not guaranteed to be embedded in the client
# bundle, which would leave the site requesting the localhost development
# snap. See packages/site/src/config/snap.ts.
#
# A production build requires GATSBY_SNAP_ORIGIN to be exactly the audited
# "npm:" snap ID and GATSBY_SNAP_VERSION to be an exact release version (no
# ranges, no tags), so installs are pinned to the audited artifact.
GATSBY_SNAP_ORIGIN=
GATSBY_SNAP_VERSION=
