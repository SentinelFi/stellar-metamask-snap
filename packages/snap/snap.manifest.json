{
  "version": "0.1.0",
  "description": "MetaMask Snap for the Stellar network with Soroban smart contract support.",
  "proposedName": "Stellar Soroban",
  "repository": {
    "type": "git",
    "url": "https://github.com/jeffnuclear/stelllar-metamask-snap.git"
  },
  "source": {
    "shasum": "a4F5B35tCjmksQ1yKckfE9x7RXG6ux+WasBq1Vq5WfU=",
    "location": {
      "npm": {
        "filePath": "dist/bundle.js",
        "iconPath": "images/icon.svg",
        "packageName": "stellar-soroban-snap",
        "registry": "https://registry.npmjs.org/"
      }
    }
  },
  "initialPermissions": {
    "snap_dialog": {},
    "snap_manageState": {},
    "endowment:page-home": {},
    "endowment:lifecycle-hooks": {},
    "endowment:rpc": {
      "dapps": true,
      "snaps": false,
      "maxRequestTime": 180000
    },
    "endowment:network-access": {},
    "snap_getBip32Entropy": [
      {
        "path": ["m", "44'", "148'"],
        "curve": "ed25519"
      }
    ]
  },
  "platformVersion": "10.3.0",
  "manifestVersion": "0.1"
}
